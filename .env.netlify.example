# 复制到 Netlify → Site configuration → Environment variables
# （不要提交真实密钥）

# 必填：托管 PostgreSQL（Neon / Supabase / RDS 等）。Serverless 建议用连接池 URL。
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require

# 必填：会话签名
AUTH_SECRET=change-to-a-long-random-secret

# 站点地址（你的 Netlify 域名）
PUBLIC_BASE_URL=https://your-site.netlify.app
COOKIE_SECURE=true

# 正式默认：关闭演示
DEMO_CODE_ENABLED=off
NEXT_PUBLIC_DEMO_MODE=off

# 短信（登录需要；sms.ts 需完成真实发送接入）
SMS_PROVIDER=aliyun
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=

PAYMENT_PROVIDER=sandbox
