# 本地 Mac 与 ECS 线上共用同一 PostgreSQL（ECS 公网 IP 直连）
# 本地：cp .env.shared-db.example .env → npm run prod:generate → npm run dev
# ECS：  合并进 .env 后配合 docker-compose.shared-db.yml 部署

DATABASE_URL=postgresql://lezyou:CHANGE_ME@HOST:5432/lezyou?schema=public

# 本地开发（默认关闭演示）
AUTH_SECRET=please-change-to-a-long-random-secret
DEMO_CODE_ENABLED=off
NEXT_PUBLIC_DEMO_MODE=off
# DEMO_CODE_ENABLED=on
# DEMO_VERIFICATION_CODE=888888
# NEXT_PUBLIC_DEMO_MODE=on
SMS_PROVIDER=aliyun
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
PUBLIC_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
PAYMENT_PROVIDER=sandbox

# ECS .env 还需保留（与 DATABASE_URL 中账号密码一致）：
# POSTGRES_USER=lezyou
# POSTGRES_DB=lezyou
# POSTGRES_PASSWORD=CHANGE_ME
# EXPOSE_DB_PUBLIC=true          # 映射 0.0.0.0:5432，WebHook 自动部署也会保留
# PUBLIC_BASE_URL=http://HOST:3000
# AUTH_SECRET=...
# CRON_SECRET=...
# GITEE_WEBHOOK_SECRET=...
# GITEE_WEBHOOK_PORT=9999
