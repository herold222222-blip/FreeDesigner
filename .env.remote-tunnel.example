# 本地 Mac 通过 SSH 隧道连接 ECS Postgres（推荐，无需安全组开放 5432）
# 1. ECS 上 db 端口绑定 127.0.0.1:5432（见 docker-compose.remote-db.yml）
# 2. 本地运行：./scripts/ssh-db-tunnel.sh
# 3. cp .env.remote-tunnel.example .env && npm run prod:generate && pnpm dev

DATABASE_URL="postgresql://lezyou:CHANGE_ME@127.0.0.1:5432/lezyou?schema=public"

AUTH_SECRET="dev-only-change-me-in-production-please-use-a-long-random-string"
SMS_PROVIDER="aliyun"
# SMS_ACCESS_KEY_ID=""
# SMS_ACCESS_KEY_SECRET=""
# SMS_SIGN_NAME=""
# SMS_TEMPLATE_CODE=""
PUBLIC_BASE_URL="http://localhost:3000"
COOKIE_SECURE="false"
PAYMENT_PROVIDER="sandbox"
