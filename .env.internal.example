# 内测环境变量（阿里云 ECS · Docker Compose）
# 用法：cp .env.internal.example .env  →  改密码/域名  →  docker compose up -d --build
#
# 默认与正式一致：关闭固定验证码与身份切换；登录需配置短信。
# 沙箱支付、空库自动播种仍可用。临时开演示：DEMO_CODE_ENABLED=on + DEMO_VERIFICATION_CODE，
# 或 ENABLE_DEMO_UI=true 后重新 build 以显示右下角身份切换。

# --- 数据库 ---
POSTGRES_USER=lezyou
POSTGRES_DB=lezyou
POSTGRES_PASSWORD=请改成强密码
# 本地 Mac / TablePlus 等图形工具直连 ECS 公网 5432（安全组仅放行你的 IP）
EXPOSE_DB_PUBLIC=true

# --- 会话（必填）---
# openssl rand -base64 48
AUTH_SECRET=请改成随机长字符串

# --- 访问方式 ---
# 已配 HTTPS + 域名：true
# 仅用 http://公网IP:3000 内测（配合 docker-compose.internal.yml）：false
COOKIE_SECURE=false

# --- 演示开关（默认关闭）---
DEMO_CODE_ENABLED=off
NEXT_PUBLIC_DEMO_MODE=off
# DEMO_CODE_ENABLED=on
# DEMO_VERIFICATION_CODE=888888
# ENABLE_DEMO_UI=true

# --- 短信（DEMO_CODE_ENABLED=off 时必填）---
SMS_PROVIDER=aliyun
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=

# --- 沙箱支付（内测默认，无需商户号）---
PAYMENT_PROVIDER=sandbox
# true=付款意图创建即成功；false=需点「确认支付」按钮
PAYMENT_SANDBOX_AUTOCONFIRM=true
# 改成你的访问地址（IP 或域名），支付回调与转发链接会用到
PUBLIC_BASE_URL=http://你的公网IP:3000

# --- 订单超时定时任务（建议配置）---
# 服务器 crontab 每小时执行 scripts/cron-order-timeouts.sh
CRON_SECRET=请改成随机字符串

# --- Gitee WebHook 自动部署 ---
GITEE_WEBHOOK_SECRET=请改成随机字符串
GITEE_WEBHOOK_PORT=9000
